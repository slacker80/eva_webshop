# Environment variables for Crystal Jewelz Webshop
# Copy this file to .env and set actual values

# Session secret for production
SESSION_SECRET=your-super-secret-session-key-here-change-in-production

# Admin password (if not set, a random password will be generated on first run)
# ADMIN_PASSWORD=your-secure-admin-password

# Node environment
NODE_ENV=production

# Port
PORT=3000

# Public site URL used for Stripe redirects/webhooks
BASE_URL=https://crystaljewelz.nl

# Stripe Checkout. Keep real values only in .env, never in git.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_CURRENCY=eur

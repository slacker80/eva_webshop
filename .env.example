# Environment variables for Crystal Jewelz Webshop
# Copy this file to .env and set actual values

# Session secret for production
SESSION_SECRET=your-super-secret-session-key-here-change-in-production

# Admin password (if not set, a random password will be generated on first run)
# ADMIN_PASSWORD=your-secure-admin-password

# Node environment
NODE_ENV=production

# Port
PORT=3000

# Public site URL used for Stripe redirects/webhooks
BASE_URL=https://crystaljewelz.nl

# Stripe is currently disabled. Orders are processed manually.

# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_CURRENCY=eur
# Order notifications
ORDER_NOTIFY_EMAIL=smallegangeeva@gmail.com
# Optional comma-separated BCC for owner notifications
# ORDER_NOTIFY_BCC=petersmallegange@gmail.com

# SMTP for order e-mails. For Gmail, use an app password.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=Crystal Jewelz <your-email@gmail.com>
